# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-key-here

# Input/Output Configuration
INPUT_DIR=./data/raw
OUTPUT_DIR=./data/reports
PROCESSED_DIR=./data/processed

# Database Configuration
BATCH_SIZE=1000
CONNECTION_POOL_SIZE=10

# Analysis Configuration
# Comma-separated list of AI tools/keywords to track
AI_TOOLS=ChatGPT,Claude,GPT-4,GPT-3,Midjourney,Stable Diffusion,DALL-E,LangChain,LlamaIndex,Pinecone,Weaviate,ChromaDB,OpenAI,Anthropic,Hugging Face,Replicate,Runway,Cohere,AI21,Vector Database

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=discord_analyzer.log
